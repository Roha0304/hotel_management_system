metry" /></mxCell><mxCell id="248" value="Multiple Values (Double Oval)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#475569;" parent="1" vertex="1"><mxGeometry x="2310" y="1565" width="150" height="25" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="eer_diagram" name="EER Diagram (Exact Image Match)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="501" value="&lt;b&gt;&lt;font style='font-size: 24px; color: #1e3a8a;'&gt;Enhanced Entity-Relationship (EER) Diagram&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font style='font-size: 14px; color: #475569;'&gt;Hotel Room Booking and Reservation Management System (hotel_management)&lt;/font&gt;&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="400" y="20" width="800" height="50" as="geometry" /></mxCell><mxCell id="502" value="&lt;div style='font-family: Arial, sans-serif; font-size: 11px;'&gt;&lt;span style='color: #dc2626; font-weight: bold;'&gt;PK = Primary Key&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color: #2563eb; font-weight: bold;'&gt;FK = Foreign Key&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color: #b45309; font-weight: bold;'&gt;UQ = Unique Key&lt;/span&gt;&lt;br/&gt;&lt;span style='color: #64748b; font-size: 10px;'&gt;Relational Model: Normalized to Third Normal Form (3NF)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="45" width="340" height="42" as="geometry" /></mxCell><mxCell id="503" value="&lt;div style='margin-top: -6px;'&gt;&lt;div style='background-color: #1e5aa8; color: #ffffff; padding: 6px 10px; font-weight: bold; font-size: 13px; text-align: center; border-radius: 4px 4px 0 0; margin: -10px -10px 8px -10px;'&gt;USERS (Guests &amp; Admins)&lt;/div&gt;&lt;div style='font-family: Consolas, monospace, sans-serif; font-size: 11px; line-height: 1.5; color: #1e293b; padding: 0 4px;'&gt;&lt;div&gt;&lt;b style='color: #dc2626;'&gt;PK&lt;/b&gt; user_id INT AUTO_INC&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; username VARCHAR(50) &lt;b style='color: #b45309;'&gt;(UQ)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; full_name VARCHAR(100)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; email VARCHAR(150) &lt;b style='color: #b45309;'&gt;(UQ)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; phone VARCHAR(20) &lt;b style='color: #b45309;'&gt;(UQ)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; password_hash VARCHAR(255)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; role ENUM('customer','admin')&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; status ENUM('Active','Inactive')&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; created_at TIMESTAMP&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e5aa8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="115" width="320" height="310" as="geometry" /></mxCell><mxCell id="504" value="&lt;div style='margin-top: -6px;'&gt;&lt;div style='background-color: #c25e00; color: #ffffff; padding: 6px 10px; font-weight: bold; font-size: 13px; text-align: center; border-radius: 4px 4px 0 0; margin: -10px -10px 8px -10px;'&gt;BOOKINGS (Reservations &amp; 25% Advance)&lt;/div&gt;&lt;div style='font-family: Consolas, monospace, sans-serif; font-size: 11px; line-height: 1.5; color: #1e293b; padding: 0 4px;'&gt;&lt;div&gt;&lt;b style='color: #dc2626;'&gt;PK&lt;/b&gt; booking_id INT AUTO_INC&lt;/div&gt;&lt;div&gt;&lt;b style='color: #2563eb;'&gt;FK&lt;/b&gt; user_id INT (FK → users)&lt;/div&gt;&lt;div&gt;&lt;b style='color: #2563eb;'&gt;FK&lt;/b&gt; room_id INT (FK → rooms)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; check_in DATE &amp; check_in_time&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; check_out DATE &amp; check_out_time&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; guest_count TINYINT&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; total_amount DECIMAL(10,2)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; advance_paid DECIMAL(10,2) [25%]&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; balance_amount DECIMAL(10,2) [75%]&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; payment_mode ENUM('Card','UPI/QR'..)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; payment_status ENUM('Advance Paid'..)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; booking_status ENUM('Confirmed'..)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; cancelled_by ENUM('customer','admin')&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; cancellation_reason VARCHAR(255)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; created_at TIMESTAMP&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c25e00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="480" y="145" width="340" height="440" as="geometry" /></mxCell><mxCell id="505" value="