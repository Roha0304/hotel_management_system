<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Antigravity DBMS Modeler" version="21.0.0" type="device"><diagram id="eer_diagram" name="EER Diagram (Exact Image Match)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="501" value="&lt;b&gt;&lt;font style='font-size: 24px; color: #1e3a8a;'&gt;Enhanced Entity-Relationship (EER) Diagram&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&lt;font style='font-size: 14px; color: #475569;'&gt;Hotel Room Booking and Reservation Management System (hotel_management)&lt;/font&gt;&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry x="400" y="20" width="800" height="50" as="geometry" /></mxCell><mxCell id="502" value="&lt;div style='font-family: Arial, sans-serif; font-size: 11px;'&gt;&lt;span style='color: #dc2626; font-weight: bold;'&gt;PK = Primary Key&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color: #2563eb; font-weight: bold;'&gt;FK = Foreign Key&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='color: #b45309; font-weight: bold;'&gt;UQ = Unique Key&lt;/span&gt;&lt;br/&gt;&lt;span style='color: #64748b; font-size: 10px;'&gt;Relational Model: Normalized to Third Normal Form (3NF)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;align=left;spacingLeft=10;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="45" width="340" height="42" as="geometry" /></mxCell><mxCell id="503" value="&lt;div style='margin-top: -6px;'&gt;&lt;div style='background-color: #1e5aa8; color: #ffffff; padding: 6px 10px; font-weight: bold; font-size: 13px; text-align: center; border-radius: 4px 4px 0 0; margin: -10px -10px 8px -10px;'&gt;USERS (Guests &amp; Admins)&lt;/div&gt;&lt;div style='font-family: Consolas, monospace, sans-serif; font-size: 11px; line-height: 1.5; color: #1e293b; padding: 0 4px;'&gt;&lt;div&gt;&lt;b style='color: #dc2626;'&gt;PK&lt;/b&gt; user_id INT AUTO_INC&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; username VARCHAR(50) &lt;b style='color: #b45309;'&gt;(UQ)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; full_name VARCHAR(100)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; email VARCHAR(150) &lt;b style='color: #b45309;'&gt;(UQ)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; phone VARCHAR(20) &lt;b style='color: #b45309;'&gt;(UQ)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; password_hash VARCHAR(255)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; role ENUM('customer','admin')&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; status ENUM('Active','Inactive')&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; created_at TIMESTAMP&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e5aa8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="115" width="320" height="310" as="geometry" /></mxCell><mxCell id="504" value="&lt;div style='margin-top: -6px;'&gt;&lt;div style='background-color: #c25e00; color: #ffffff; padding: 6px 10px; font-weight: bold; font-size: 13px; text-align: center; border-radius: 4px 4px 0 0; margin: -10px -10px 8px -10px;'&gt;BOOKINGS (Reservations &amp; 25% Advance)&lt;/div&gt;&lt;div style='font-family: Consolas, monospace, sans-serif; font-size: 11px; line-height: 1.5; color: #1e293b; padding: 0 4px;'&gt;&lt;div&gt;&lt;b style='color: #dc2626;'&gt;PK&lt;/b&gt; booking_id INT AUTO_INC&lt;/div&gt;&lt;div&gt;&lt;b style='color: #2563eb;'&gt;FK&lt;/b&gt; user_id INT (FK → users)&lt;/div&gt;&lt;div&gt;&lt;b style='color: #2563eb;'&gt;FK&lt;/b&gt; room_id INT (FK → rooms)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; check_in DATE &amp; check_in_time&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; check_out DATE &amp; check_out_time&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; guest_count TINYINT&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; total_amount DECIMAL(10,2)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; advance_paid DECIMAL(10,2) [25%]&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; balance_amount DECIMAL(10,2) [75%]&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; payment_mode ENUM('Card','UPI/QR'..)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; payment_status ENUM('Advance Paid'..)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; booking_status ENUM('Confirmed'..)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; cancelled_by ENUM('customer','admin')&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; cancellation_reason VARCHAR(255)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; created_at TIMESTAMP&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c25e00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="480" y="145" width="340" height="440" as="geometry" /></mxCell><mxCell id="505" value="&lt;div style='margin-top: -6px;'&gt;&lt;div style='background-color: #1e6b37; color: #ffffff; padding: 6px 10px; font-weight: bold; font-size: 13px; text-align: center; border-radius: 4px 4px 0 0; margin: -10px -10px 8px -10px;'&gt;ROOMS (Physical Inventory)&lt;/div&gt;&lt;div style='font-family: Consolas, monospace, sans-serif; font-size: 11px; line-height: 1.5; color: #1e293b; padding: 0 4px;'&gt;&lt;div&gt;&lt;b style='color: #dc2626;'&gt;PK&lt;/b&gt; room_id INT AUTO_INC&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; room_number VARCHAR(10) &lt;b style='color: #b45309;'&gt;(UQ)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; room_type ENUM('Standard'..)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; capacity TINYINT (1-10)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; price_per_night DECIMAL(10,2)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; amenities VARCHAR(500)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; image_url VARCHAR(500)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; status ENUM('Available'..)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; created_at TIMESTAMP&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1e6b37;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="920" y="115" width="320" height="310" as="geometry" /></mxCell><mxCell id="506" value="&lt;div style='margin-top: -6px;'&gt;&lt;div style='background-color: #5c3a93; color: #ffffff; padding: 6px 10px; font-weight: bold; font-size: 13px; text-align: center; border-radius: 4px 4px 0 0; margin: -10px -10px 8px -10px;'&gt;PAYMENTS (Transaction Ledger)&lt;/div&gt;&lt;div style='font-family: Consolas, monospace, sans-serif; font-size: 11px; line-height: 1.5; color: #1e293b; padding: 0 4px;'&gt;&lt;div&gt;&lt;b style='color: #dc2626;'&gt;PK&lt;/b&gt; pay_id INT AUTO_INC&lt;/div&gt;&lt;div&gt;&lt;b style='color: #2563eb;'&gt;FK&lt;/b&gt; user_id INT (FK → users)&lt;/div&gt;&lt;div&gt;&lt;b style='color: #2563eb;'&gt;FK&lt;/b&gt; room_id INT (FK → rooms)&lt;/div&gt;&lt;div&gt;&lt;b style='color: #2563eb;'&gt;FK&lt;/b&gt; booking_id INT (FK → bookings)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; amount DECIMAL(10,2) [25% Adv]&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; currency CHAR(3) DEFAULT 'INR'&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; gateway_order_id VARCHAR(64) &lt;b style='color: #b45309;'&gt;(UQ)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; gateway_payment_id VARCHAR(64)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; method VARCHAR(30)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; status ENUM('Created','Paid'..)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; created_at &amp; updated_at&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c3a93;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="60" y="480" width="320" height="340" as="geometry" /></mxCell><mxCell id="507" value="&lt;div style='margin-top: -6px;'&gt;&lt;div style='background-color: #3d4b5c; color: #ffffff; padding: 6px 10px; font-weight: bold; font-size: 13px; text-align: center; border-radius: 4px 4px 0 0; margin: -10px -10px 8px -10px;'&gt;BOOKING_AUDIT (Trigger Logs)&lt;/div&gt;&lt;div style='font-family: Consolas, monospace, sans-serif; font-size: 11px; line-height: 1.5; color: #1e293b; padding: 0 4px;'&gt;&lt;div&gt;&lt;b style='color: #dc2626;'&gt;PK&lt;/b&gt; audit_id BIGINT AUTO_INC&lt;/div&gt;&lt;div&gt;&lt;b style='color: #2563eb;'&gt;FK&lt;/b&gt; booking_id INT (FK)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; action_type VARCHAR(30)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; old_status VARCHAR(30)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; new_status VARCHAR(30)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; details VARCHAR(255)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; changed_at TIMESTAMP&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d4b5c;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="920" y="460" width="320" height="240" as="geometry" /></mxCell><mxCell id="508" value="&lt;div style='margin-top: -6px;'&gt;&lt;div style='background-color: #824513; color: #ffffff; padding: 6px 10px; font-weight: bold; font-size: 13px; text-align: center; border-radius: 4px 4px 0 0; margin: -10px -10px 8px -10px;'&gt;REPORT_ROOM_SUMMARY (Cursor)&lt;/div&gt;&lt;div style='font-family: Consolas, monospace, sans-serif; font-size: 11px; line-height: 1.5; color: #1e293b; padding: 0 4px;'&gt;&lt;div&gt;&lt;b style='color: #dc2626;'&gt;PK&lt;/b&gt; summary_id INT AUTO_INC&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; room_type VARCHAR(50)&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; total_rooms, available_rooms INT&lt;/div&gt;&lt;div&gt;&lt;span style='color: #94a3b8;'&gt;•&lt;/span&gt; total_bookings, revenue, avg_rate&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#824513;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;shadow=1;" parent="1" vertex="1"><mxGeometry x="920" y="735" width="320" height="160" as="geometry" /></mxCell><mxCell id="509" value="1 : N&lt;br/&gt;&lt;b&gt;places&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1e5aa8;strokeWidth=2;fontSize=11;fontColor=#1e5aa8;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" parent="1" edge="1" source="503" target="504"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="510" value="1 : N&lt;br/&gt;&lt;b&gt;reserved&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1e6b37;strokeWidth=2;fontSize=11;fontColor=#1e6b37;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" parent="1" edge="1" source="505" target="504"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="511" value="1 : 1&lt;br/&gt;&lt;b&gt;paid by&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5c3a93;strokeWidth=2;fontSize=11;fontColor=#5c3a93;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;entryX=1;entryY=0.5;exitX=0;exitY=0.85;" parent="1" edge="1" source="504" target="506"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="512" value="1 : N&lt;br/&gt;&lt;b&gt;audits&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3d4b5c;strokeWidth=2;fontSize=11;fontColor=#3d4b5c;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" parent="1" edge="1" source="504" target="507"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>